<Window x:Class="NoteManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Note Manager Pro" Height="600" Width="900"
        MinHeight="500" MinWidth="720"
        Background="#F0F2F5" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Базовий стиль кнопок з rounded corners -->
        <Style x:Key="RoundBtn" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стилі кольорових кнопок -->
        <Style x:Key="BtnGreen"  BasedOn="{StaticResource RoundBtn}" TargetType="Button">
            <Setter Property="Background" Value="#2ECC71"/>
        </Style>
        <Style x:Key="BtnYellow" BasedOn="{StaticResource RoundBtn}" TargetType="Button">
            <Setter Property="Background" Value="#F39C12"/>
        </Style>
        <Style x:Key="BtnBlue"   BasedOn="{StaticResource RoundBtn}" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
        </Style>
        <Style x:Key="BtnRed"    BasedOn="{StaticResource RoundBtn}" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
        </Style>
        <Style x:Key="BtnPurple" BasedOn="{StaticResource RoundBtn}" TargetType="Button">
            <Setter Property="Background" Value="#9B59B6"/>
        </Style>
        <Style x:Key="BtnGray"   BasedOn="{StaticResource RoundBtn}" TargetType="Button">
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Стиль TextBox -->
        <Style x:Key="ModernBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Стиль елемента списку нотаток -->
        <Style x:Key="NoteItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="White" CornerRadius="10"
                                Padding="12,10" Margin="2,3"
                                BorderThickness="1" BorderBrush="#EAE8E8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EBF5FB"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3498DB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F4F6F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" MinWidth="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ ЛІВА ПАНЕЛЬ ══════════ -->
        <Border Grid.Column="0" Background="#FFFFFF"
                BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,14,12,12">

                <!-- Заголовок -->
                <TextBlock DockPanel.Dock="Top"
                           Text="📝 Нотатки"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#2C3E50"
                           Margin="0,0,0,12"/>

                <!-- Пошук -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchInput"
                             Grid.Column="0"
                             Style="{StaticResource ModernBox}"
                             Height="34"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="🔍"
                            Style="{StaticResource BtnBlue}"
                            Padding="10,6"
                            Margin="5,0,0,0"
                            Height="34"
                            Click="SearchButton_Click"/>
                    </Grid>

                <Button x:Name="ThemeBtn" Content="🌙" Style="{StaticResource BtnGray}" DockPanel.Dock="Top" Padding="8,5" Margin="0,0,0,8" HorizontalAlignment="Right" Click="ThemeButton_Click"/>
                <!-- Сортування -->
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="0,0,0,10">
                    <Button Content="A–Z"
                            Style="{StaticResource BtnGray}"
                            Padding="12,5" FontSize="12"
                            Click="SortTitleButton_Click"/>
                    <Button Content="🕐 Нові"
                            Style="{StaticResource BtnGray}"
                            Padding="12,5" FontSize="12"
                            Margin="6,0,0,0"
                            Click="SortDateButton_Click"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="Всі теги"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#95A5A6"
                           Margin="0,8,0,4"/>
                <WrapPanel x:Name="AllTagsPanel" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                <Separator DockPanel.Dock="Top" Margin="0,0,0,8"/>
                <ComboBox x:Name="FilterCategoryBox" DockPanel.Dock="Top" Height="28" Margin="0,0,0,8" FontSize="11" SelectionChanged="FilterCategory_SelectionChanged">
                    <ComboBoxItem Content="Всі категорії" IsSelected="True"/>
                    <ComboBoxItem Content="Загальне"/>
                    <ComboBoxItem Content="Навчання"/>
                    <ComboBoxItem Content="Робота"/>
                    <ComboBoxItem Content="Особисте"/>
                    <ComboBoxItem Content="Ідеї"/>
                    <ComboBoxItem Content="Код"/>
                </ComboBox>
                <!-- Список нотаток -->
                <ListBox x:Name="NotesList"
                         SelectionChanged="NotesList_SelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NoteItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#2C3E50"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                               FontSize="10"
                                               Foreground="#95A5A6"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- Індикатор Pin -->
                                <TextBlock Grid.Column="1"
                                           Text="📌"
                                           FontSize="14"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>

        <!-- ══════════ ПРАВА ПАНЕЛЬ ══════════ -->
        <DockPanel Grid.Column="1" Margin="18,14,18,14">

            <!-- Кнопки -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,28">
                <Button Content="➕ Нова"
                        Style="{StaticResource BtnGreen}"
                        Click="NewNoteButton_Click"/>
                <Button Content="📋 Історія"
                        Style="{StaticResource BtnGray}"
                        Margin="8,0,0,0"
                        Click="HistoryButton_Click"/>
                <Button Content="↩ Відміна"
                        Style="{StaticResource BtnYellow}"
                        Margin="8,0,0,0"
                        Click="UndoButton_Click"/>
                <Button Content="📌 Пін"
                        Style="{StaticResource BtnPurple}"
                        Margin="8,0,0,0"
                        Click="PinButton_Click"/>
                <Button Content="💾 Зберегти"
                        Style="{StaticResource BtnBlue}"
                        Margin="8,0,0,0"
                        Click="SaveNoteButton_Click"/>
                <Button Content="📤 Експорт"
                        Style="{StaticResource BtnGray}"
                        Margin="8,0,0,0"
                        Click="ExportButton_Click"/>
                <Button Content="🗑 Видалити"
                        Style="{StaticResource BtnRed}"
                        Margin="8,0,0,0"
                        Click="DeleteNoteButton_Click"/>
            </StackPanel>

            <!-- Теги — chips -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="Теги (через кому)"
                           FontWeight="SemiBold" FontSize="12"
                           Foreground="#5D6D7E"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TagsInput"
                         Style="{StaticResource ModernBox}"
                         Height="34"
                         VerticalContentAlignment="Center"/>
                <!-- Chips відображення -->
                <WrapPanel x:Name="TagChipsPanel" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Назва -->
            <TextBlock DockPanel.Dock="Top"
                       Text="Назва"
                       FontWeight="SemiBold" FontSize="12"
                       Foreground="#5D6D7E"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="TitleInput"
                     DockPanel.Dock="Top"
                     Style="{StaticResource ModernBox}"
                     FontSize="15" FontWeight="SemiBold"
                     Height="36"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,12"/>

            <!-- Категорія -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Категорія:" FontWeight="SemiBold" FontSize="12"
                           Foreground="#5D6D7E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                
            </StackPanel>
            <!-- Категорія -->
            <TextBlock DockPanel.Dock="Top" Text="Категорія" FontWeight="SemiBold" FontSize="12" Foreground="#5D6D7E" Margin="0,0,0,4"/>
            <ComboBox x:Name="CategoryBox" DockPanel.Dock="Top" Height="32" Margin="0,0,0,10" FontSize="13"
                      SelectionChanged="CategoryBox_SelectionChanged">
                <ComboBoxItem Content="Загальне" IsSelected="True"/>
                <ComboBoxItem Content="Навчання"/>
                <ComboBoxItem Content="Робота"/>
                <ComboBoxItem Content="Особисте"/>
                <ComboBoxItem Content="Ідеї"/>
                <ComboBoxItem Content="Код"/>
            </ComboBox>
            <!-- Зміст -->
            <TextBlock DockPanel.Dock="Top" x:Name="CharCounter" Text="0 символів | 0 слів" FontSize="10" Foreground="#95A5A6" HorizontalAlignment="Right" Margin="0,0,0,2"/>
            <TextBlock DockPanel.Dock="Top"
                       Text="Зміст"
                       FontWeight="SemiBold" FontSize="12"
                       Foreground="#5D6D7E"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="ContentInput"
                     Style="{StaticResource ModernBox}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="13"
                     VerticalAlignment="Stretch"/>

        </DockPanel>
    <StatusBar Grid.ColumnSpan="2" VerticalAlignment="Bottom" Background="#2C3E50" Height="24">
        <StatusBarItem>
            <TextBlock x:Name="StatusText" Foreground="White" FontSize="11" Text="Готово" Margin="5,0"/>
        </StatusBarItem>
    </StatusBar>
</Grid>
</Window>



























